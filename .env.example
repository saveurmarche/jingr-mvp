# URL publique (liens envoyés sur WhatsApp, sitemap)
APP_URL=https://jingr.ai
OPS_PASSWORD=change-me

# Base de données (sinon store fichier local data/store.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA : génération des devis, extraction du chantier, transcription des vocaux
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# WhatsApp Cloud API (Meta)
WHATSAPP_TEST_MODE=true
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Numéro jingr au format international sans + (bouton « WhatsApp » du site)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Offre
FREE_DRAFTS=10
NEXT_PUBLIC_PRICE_MONTHLY=29
# Lien de paiement Stripe (Payment Link, abonnement mensuel)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
